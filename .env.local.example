# Copy to .env.local (gitignored) for local development.
# In production these are set as encrypted Vercel environment variables, never committed.
SITE_PASSWORD=change-me

# Needed for `npm run sync-digest` (lists + reads past sends). Must be a
# full-access key — a sending-only key can send but can't call GET /emails.
RESEND_API_KEY=re_your_full_access_api_key_here

# Only needed in production, for the /api/news-digest ingestion route the
# portfolio-news-digest cloud routine calls after each run. Not required
# for local dev of the dashboard itself.
DIGEST_INGEST_SECRET=
GITHUB_TOKEN=